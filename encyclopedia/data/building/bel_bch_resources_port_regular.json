 recruitment capacity: +1","tone":"good"},{"text":"Squalor: +2","tone":"bad"}],"units":["att_shp_des_corsairs_dro_light","att_shp_des_heavy_corsairs_lib_light","att_shp_des_naval_bowmen_dro_light","att_shp_eas_artillery_lib_light","att_shp_eas_hurlers_dro_light","att_shp_eas_light_boatmen_dro_light","att_shp_er_marines_dro_light_fs","att_shp_ger_artillery_lib_light","att_shp_ger_boatment_lib_light_ram","att_shp_ger_bow_lon_light","att_shp_ger_light_marauders_lon_light","att_shp_rom_artillery_lib_light","att_shp_rom_light_marines_lib_light","att_shp_rom_skirmisher_lib_light","att_shp_van_artillery_lib_light","att_shp_van_boatmen_dro_light_fs","att_shp_van_boatmen_lib_light_ram","att_shp_van_bow_lon_light_dagger","att_shp_van_light_marauders_lon_light","att_shp_wr_light_marines_lib_light_ram"],"garrison":["rex_shp_alan_bow_dro_light_ger","rex_shp_alan_bow_trans_heavy","rex_shp_alan_bow_trans_light","rex_shp_des_bow_trans_light","rex_shp_eas_bow_dro_light","rex_shp_eas_bow_trans_heavy","rex_shp_fra_swordsmen_lon_heavy","rex_shp_ger_axemen_lon_light","rex_shp_ger_bow_lon_light","rex_shp_ger_bow_trans_heavy","rex_shp_ger_bow_trans_light","rex_shp_ger_swordsmen_lon_heavy","rex_shp_got_swordsmen_lon_heavy","rex_shp_rom_bow_lib_light","rex_shp_rom_heavy_marines_lib_heavy","rex_shp_rom_marines_lib_light"]},{"key":"bel_bld_all_resources_port_trade_2","tier":3,"cost":3000,"turns":4,"upkeep":0,"capital_only":false,"religion":"","resource":"","techs":[],"upgrades":["bel_bld_all_resources_port_trade_3"],"from":["bel_bld_all_resources_port_generic_1"],"variants":[{"id":"bel_bld_all_resources_port_trade_2","subcultures":["att_sub_cult_barbarian_celtic","att_sub_cult_barbarian_germanic_east","att_sub_cult_barbarian_germanic_north","att_sub_cult_barbarian_germanic_west","att_sub_cult_eastern_caucasian","att_sub_cult_eastern_desert","att_sub_cult_eastern_sassanid","att_sub_cult_nomadic_hunnic","att_sub_cult_nomadic_sarmatian","att_sub_cult_roman_east","att_sub_cult_roman_west","bel_su