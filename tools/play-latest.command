#!/bin/zsh
# Double-click: start the newest campaign save with TWASE and the region trading mod from this repo, without Feral's
# launcher (tools/play.sh --latest). Installed next to twase-launch.command in the game folder; the source is
# ~/GitHub/attila-mods/tools/play-latest.command.
exec "$HOME/GitHub/attila-mods/tools/play.sh" --latest
